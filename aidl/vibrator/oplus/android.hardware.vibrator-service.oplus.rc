# The HAL starts with class hal in "on boot", so hand over the Awinic nodes before that.
on early-boot
    chown system system /sys/class/leds/vibrator/oplus_activate
    chown system system /sys/class/leds/vibrator/oplus_duration
    chown system system /sys/class/leds/vibrator/oplus_state
    chown system system /sys/class/leds/vibrator/gain
    chown system system /dev/awinic_haptic
    chmod 0600 /dev/awinic_haptic

service vendor.vibrator-oplus /vendor/bin/hw/android.hardware.vibrator-service.oplus
    class hal
    user system
    group system input
